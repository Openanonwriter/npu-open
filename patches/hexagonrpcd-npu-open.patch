diff --git a/hexagonrpcd/apps_mem.c b/hexagonrpcd/apps_mem.c
index 1477f0b..2e5d296 100644
--- a/hexagonrpcd/apps_mem.c
+++ b/hexagonrpcd/apps_mem.c
@@ -36,8 +36,12 @@
 #define ADSP_MMAP_REMOTE_HEAP_ADDR 8
 #define ADSP_MMAP_ADD_PAGES   0x1000
 
+#define APPS_MEM_MAX_MAPS 64
+
 struct apps_mem_ctx {
 	int fd;
+	/* The DSP is only told the low 32 bits of each mapping; remember the full address for unmapping. */
+	uint64_t maps[APPS_MEM_MAX_MAPS];
 };
 
 static uint32_t apps_mem_request_map64(void *data,
@@ -87,8 +91,52 @@ static uint32_t apps_mem_request_map64(void *data,
 	       mmap.vaddrout);
 #endif
 
+	for (size_t i = 0; i < APPS_MEM_MAX_MAPS; i++) {
+		if (ctx->maps[i] == 0) {
+			ctx->maps[i] = mmap.vaddrout;
+			break;
+		}
+	}
+
 	first_out->vapps = 0;
-	first_out->vadsp = mmap.vaddrout & 0xFFFFFFFF;
+	first_out->vadsp = getenv("HRPC_VADSP32") ? (mmap.vaddrout & 0xFFFFFFFF) : mmap.vaddrout;  /* npu-open: pass the full address, as qualcomm/fastrpc does */
+	return 0;
+}
+
+static uint32_t apps_mem_request_unmap64(void *data,
+					 const struct fastrpc_io_buffer *inbufs,
+					 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_mem_ctx *ctx = data;
+	const struct {
+		uint64_t vadsp;
+		uint64_t len;
+	} *first_in = inbufs[0].p;
+	struct fastrpc_req_munmap munmap;
+	size_t slot = APPS_MEM_MAX_MAPS;
+	int ret;
+
+	munmap.vaddrout = first_in->vadsp;
+	munmap.size = first_in->len;
+	for (size_t i = 0; i < APPS_MEM_MAX_MAPS; i++) {
+		if (ctx->maps[i] && (ctx->maps[i] & 0xFFFFFFFF) == (first_in->vadsp & 0xFFFFFFFF)) {
+			munmap.vaddrout = ctx->maps[i];
+			slot = i;
+			break;
+		}
+	}
+
+	ret = ioctl(ctx->fd, FASTRPC_IOCTL_MUNMAP, &munmap);
+#if HEXAGONRPC_VERBOSE
+	printf("munmap(%" PRIx64 ", %" PRIu64 ") -> %d\n", (uint64_t) munmap.vaddrout, (uint64_t) munmap.size, ret);
+#endif
+	if (ret) {
+		fprintf(stderr, "Memory unmap failed: %s\n", hexagonrpc_strerror(ret));
+		return ret;
+	}
+	if (slot < APPS_MEM_MAX_MAPS)
+		ctx->maps[slot] = 0;
+
 	return 0;
 }
 
